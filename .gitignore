# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
wheelhouse/
*.egg-info

# The compiled core (maturin develop puts hedonic/_core.*.so beside the sources)
# and the crate's build folder (native/rust/.gitignore)
*.so
*.pyd

# Virtual environments
.venv

# macOS files
.DS_Store

# Web explainer (web/): dependencies and build output are reproducible from
# package-lock.json; web/dist/ is also covered by the dist/ rule above.
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
