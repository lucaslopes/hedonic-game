# The C core and its binding are compiled into hedonic._core (setup.py); the
# sdist carries them, the wheel only the built extension.
recursive-include native *.c *.h *.py Makefile README.md
include setup.py

# Package data of the experiment CLI (also listed in pyproject.toml's package-data).
recursive-include src/hedonic/experiments/configs *.toml
global-exclude __pycache__ *.py[co]
